{
  "openapi": "3.1.0",
  "info": {
    "title": "Paper Watch API",
    "summary": "Ask questions about the stored AI-research corpus and stream cited answers.",
    "version": "0.2"
  },
  "paths": {
    "/healthz": {
      "get": {
        "summary": "Healthz",
        "description": "Liveness: the process is up. It deliberately does not touch the database.",
        "operationId": "healthz_healthz_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Healthz Healthz Get"
                }
              }
            }
          }
        }
      }
    },
    "/readyz": {
      "get": {
        "summary": "Readyz",
        "description": "Readiness: an answer needs the database, so readiness means one query succeeds.",
        "operationId": "readyz_readyz_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/status": {
      "get": {
        "summary": "Status",
        "description": "The search mode the page reads on load: hybrid, or keyword-only and why.",
        "operationId": "status_status_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StatusData"
                }
              }
            }
          }
        }
      }
    },
    "/ask": {
      "post": {
        "summary": "Ask",
        "description": "Answer one question as server-sent events, one `itemSchema` event per frame.",
        "operationId": "ask_ask_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AskRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Server-sent events, one JSON object per `data:` line. The `event` line names the payload: `tool`, `step`, `source`, `token`, `notice`, `answer` or `error`. A `: ping` comment line arrives after 15 s of silence; it has no `data:`. `answer` is the last event unless an `error` follows; a client replaces its streamed text with the `answer` event's `text`, never appends it, and takes every link from its `citations[].url`.",
            "content": {
              "text/event-stream": {
                "itemSchema": {
                  "type": "object",
                  "properties": {
                    "event": {
                      "type": "string",
                      "enum": [
                        "tool",
                        "step",
                        "source",
                        "token",
                        "notice",
                        "answer",
                        "error"
                      ]
                    },
                    "data": {
                      "type": "string",
                      "contentMediaType": "application/json",
                      "contentSchema": {
                        "anyOf": [
                          {
                            "$ref": "#/components/schemas/ToolData"
                          },
                          {
                            "$ref": "#/components/schemas/StepData"
                          },
                          {
                            "$ref": "#/components/schemas/SourceData"
                          },
                          {
                            "$ref": "#/components/schemas/TokenData"
                          },
                          {
                            "$ref": "#/components/schemas/NoticeData"
                          },
                          {
                            "$ref": "#/components/schemas/AnswerData"
                          },
                          {
                            "$ref": "#/components/schemas/ErrorData"
                          }
                        ]
                      }
                    }
                  },
                  "required": [
                    "event",
                    "data"
                  ]
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AnswerData": {
        "properties": {
          "text": {
            "type": "string",
            "title": "Text"
          },
          "search_mode": {
            "type": "string",
            "enum": [
              "hybrid",
              "text_only"
            ],
            "title": "Search Mode",
            "description": "Hybrid retrieval, or the keyword-only branch during a run.",
            "default": "hybrid"
          },
          "supported": {
            "type": "boolean",
            "title": "Supported",
            "description": "True when every visible claim points at a retrieved source. That is not a verification: sentences under six words and numbers are not checked."
          },
          "citations": {
            "items": {
              "$ref": "#/components/schemas/CitationData"
            },
            "type": "array",
            "title": "Citations"
          },
          "flags": {
            "items": {
              "$ref": "#/components/schemas/FlagData"
            },
            "type": "array",
            "title": "Flags"
          }
        },
        "type": "object",
        "required": [
          "text",
          "supported",
          "citations",
          "flags"
        ],
        "title": "AnswerData"
      },
      "AskRequest": {
        "properties": {
          "question": {
            "type": "string",
            "maxLength": 1000,
            "minLength": 1,
            "title": "Question"
          },
          "tiers": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/Tier"
                },
                "type": "array",
                "maxItems": 3
              },
              {
                "type": "null"
              }
            ],
            "title": "Tiers"
          },
          "profiles": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array",
                "maxItems": 8
              },
              {
                "type": "null"
              }
            ],
            "title": "Profiles"
          },
          "since": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ],
            "title": "Since"
          }
        },
        "type": "object",
        "required": [
          "question"
        ],
        "title": "AskRequest"
      },
      "CitationData": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id",
            "description": "The per-answer source alias, such as S1."
          },
          "item_id": {
            "type": "string",
            "title": "Item Id"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "url": {
            "type": "string",
            "title": "Url"
          },
          "tier": {
            "type": "string",
            "title": "Tier"
          },
          "basis": {
            "type": "string",
            "title": "Basis"
          }
        },
        "type": "object",
        "required": [
          "id",
          "item_id",
          "title",
          "url",
          "tier",
          "basis"
        ],
        "title": "CitationData"
      },
      "ErrorData": {
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "daily_cap",
              "budget",
              "model_unavailable",
              "internal",
              "deadline"
            ],
            "title": "Code"
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "retry_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Retry At"
          }
        },
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorData"
      },
      "FlagData": {
        "properties": {
          "kind": {
            "type": "string",
            "title": "Kind"
          },
          "sentence": {
            "type": "string",
            "title": "Sentence"
          },
          "detail": {
            "type": "string",
            "title": "Detail"
          }
        },
        "type": "object",
        "required": [
          "kind",
          "sentence",
          "detail"
        ],
        "title": "FlagData"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "NoticeData": {
        "properties": {
          "code": {
            "type": "string",
            "const": "text_only",
            "title": "Code"
          },
          "message": {
            "type": "string",
            "title": "Message"
          }
        },
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "title": "NoticeData",
        "description": "The `notice` event: the answer runs in a reduced mode and says so."
      },
      "SourceData": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id",
            "description": "The per-answer source alias, such as S1."
          },
          "item_id": {
            "type": "string",
            "title": "Item Id"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "url": {
            "type": "string",
            "title": "Url"
          },
          "tier": {
            "type": "string",
            "title": "Tier"
          },
          "basis": {
            "type": "string",
            "title": "Basis"
          }
        },
        "type": "object",
        "required": [
          "id",
          "item_id",
          "title",
          "url",
          "tier",
          "basis"
        ],
        "title": "SourceData",
        "description": "The `source` event: a source a tool just returned, in alias order."
      },
      "StatusData": {
        "properties": {
          "mode": {
            "type": "string",
            "enum": [
              "hybrid",
              "text_only"
            ],
            "title": "Mode"
          },
          "reason": {
            "type": "string",
            "enum": [
              "ok",
              "ingestion",
              "memory",
              "database"
            ],
            "title": "Reason"
          },
          "since": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Since"
          }
        },
        "type": "object",
        "required": [
          "mode",
          "reason"
        ],
        "title": "StatusData",
        "description": "`GET /status`: the search mode the page reads on load."
      },
      "StepData": {
        "properties": {
          "round": {
            "type": "integer",
            "title": "Round"
          },
          "ms": {
            "type": "integer",
            "title": "Ms"
          },
          "new_sources": {
            "type": "integer",
            "title": "New Sources"
          }
        },
        "type": "object",
        "required": [
          "round",
          "ms",
          "new_sources"
        ],
        "title": "StepData",
        "description": "The `step` event: one tool round finished."
      },
      "Tier": {
        "type": "string",
        "enum": [
          "peer_reviewed",
          "vetted_preprint",
          "lab_blog"
        ],
        "title": "Tier"
      },
      "TokenData": {
        "properties": {
          "text": {
            "type": "string",
            "title": "Text"
          }
        },
        "type": "object",
        "required": [
          "text"
        ],
        "title": "TokenData",
        "description": "The `token` event: a piece of the model's answer, before the citation check."
      },
      "ToolData": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "args": {
            "additionalProperties": true,
            "type": "object",
            "title": "Args"
          }
        },
        "type": "object",
        "required": [
          "name",
          "args"
        ],
        "title": "ToolData",
        "description": "The `tool` event: the model called one of the corpus tools."
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
