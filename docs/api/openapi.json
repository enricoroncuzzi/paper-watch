{
  "openapi": "3.1.0",
  "info": {
    "title": "Paper Watch API",
    "summary": "Ask questions about the stored AI-research corpus and stream cited answers.",
    "version": "0.1"
  },
  "paths": {
    "/healthz": {
      "get": {
        "summary": "Healthz",
        "description": "Liveness: the process is up. It deliberately does not touch the database.",
        "operationId": "healthz_healthz_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Healthz Healthz Get"
                }
              }
            }
          }
        }
      }
    },
    "/readyz": {
      "get": {
        "summary": "Readyz",
        "description": "Readiness: an answer needs the database, so readiness means one query succeeds.",
        "operationId": "readyz_readyz_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/ask": {
      "post": {
        "summary": "Ask",
        "description": "Answer one question as server-sent events, one `StreamItem` per event.",
        "operationId": "ask_ask_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AskRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Server-sent events, one JSON object per `data:` line. The `event` line names the payload: `tool`, `token`, `answer` or `error`. `answer` is the last event unless an `error` follows; a client replaces its streamed text with the `answer` event's `text`, never appends it, and takes every link from its `citations[].url`.",
            "content": {
              "text/event-stream": {
                "schema": {
                  "$ref": "#/components/schemas/StreamItem"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AnswerData": {
        "properties": {
          "text": {
            "type": "string",
            "title": "Text"
          },
          "supported": {
            "type": "boolean",
            "title": "Supported",
            "description": "True when every visible claim points at a retrieved source. That is not a verification: sentences under six words and numbers are not checked."
          },
          "citations": {
            "items": {
              "$ref": "#/components/schemas/CitationData"
            },
            "type": "array",
            "title": "Citations"
          },
          "flags": {
            "items": {
              "$ref": "#/components/schemas/FlagData"
            },
            "type": "array",
            "title": "Flags"
          }
        },
        "type": "object",
        "required": [
          "text",
          "supported",
          "citations",
          "flags"
        ],
        "title": "AnswerData"
      },
      "AskRequest": {
        "properties": {
          "question": {
            "type": "string",
            "maxLength": 1000,
            "minLength": 1,
            "title": "Question"
          },
          "tiers": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/Tier"
                },
                "type": "array",
                "maxItems": 3
              },
              {
                "type": "null"
              }
            ],
            "title": "Tiers"
          },
          "profiles": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array",
                "maxItems": 8
              },
              {
                "type": "null"
              }
            ],
            "title": "Profiles"
          },
          "since": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ],
            "title": "Since"
          }
        },
        "type": "object",
        "required": [
          "question"
        ],
        "title": "AskRequest"
      },
      "CitationData": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id",
            "description": "The per-answer source alias, such as S1."
          },
          "item_id": {
            "type": "string",
            "title": "Item Id"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "url": {
            "type": "string",
            "title": "Url"
          },
          "tier": {
            "type": "string",
            "title": "Tier"
          },
          "basis": {
            "type": "string",
            "title": "Basis"
          }
        },
        "type": "object",
        "required": [
          "id",
          "item_id",
          "title",
          "url",
          "tier",
          "basis"
        ],
        "title": "CitationData"
      },
      "ErrorData": {
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "daily_cap",
              "budget",
              "model_unavailable",
              "internal"
            ],
            "title": "Code"
          },
          "message": {
            "type": "string",
            "title": "Message"
          }
        },
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorData"
      },
      "FlagData": {
        "properties": {
          "kind": {
            "type": "string",
            "title": "Kind"
          },
          "sentence": {
            "type": "string",
            "title": "Sentence"
          },
          "detail": {
            "type": "string",
            "title": "Detail"
          }
        },
        "type": "object",
        "required": [
          "kind",
          "sentence",
          "detail"
        ],
        "title": "FlagData"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "StreamItem": {
        "properties": {
          "event": {
            "type": "string",
            "enum": [
              "tool",
              "token",
              "answer",
              "error"
            ],
            "title": "Event"
          },
          "data": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ToolData"
              },
              {
                "$ref": "#/components/schemas/TokenData"
              },
              {
                "$ref": "#/components/schemas/AnswerData"
              },
              {
                "$ref": "#/components/schemas/ErrorData"
              }
            ],
            "title": "Data"
          }
        },
        "type": "object",
        "required": [
          "event",
          "data"
        ],
        "title": "StreamItem",
        "description": "One server-sent event: the `event` name and the JSON payload of its `data` line.\n\nOn the wire each event is one `event: <event>` line and one `data: <json>` line, with no\nblank line inside the payload; a client replaces its streamed text with `answer.data.text`."
      },
      "Tier": {
        "type": "string",
        "enum": [
          "peer_reviewed",
          "vetted_preprint",
          "lab_blog"
        ],
        "title": "Tier"
      },
      "TokenData": {
        "properties": {
          "text": {
            "type": "string",
            "title": "Text"
          }
        },
        "type": "object",
        "required": [
          "text"
        ],
        "title": "TokenData",
        "description": "The `token` event: a piece of the model's answer, before the citation check."
      },
      "ToolData": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "args": {
            "additionalProperties": true,
            "type": "object",
            "title": "Args"
          }
        },
        "type": "object",
        "required": [
          "name",
          "args"
        ],
        "title": "ToolData",
        "description": "The `tool` event: the model called one of the corpus tools."
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
