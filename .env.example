# Copy to .env (gitignored) and fill in only what you need; unset values use the defaults in
# src/paperwatch/config.py. Never commit real values.
PW_DATABASE_URL=
PW_EMBEDDING_PROVIDER=
PW_CLASSIFIER_PROVIDER=
PW_LOCAL_EMBEDDING_MODEL=
PW_LOCAL_EMBEDDING_CACHE_DIR=
PW_LOCAL_EMBEDDING_THREADS=
PW_LOCAL_EMBEDDING_BATCH=
PW_LOCAL_EMBEDDING_CPU_ARENA=
PW_AZURE_OPENAI_ENDPOINT=
PW_AZURE_OPENAI_API_KEY=
PW_AZURE_OPENAI_API_VERSION=
PW_EMBEDDING_DEPLOYMENT=
PW_CLASSIFIER_DEPLOYMENT=
PW_MAX_TOKENS_PER_RUN=
PW_SEMANTIC_SCHOLAR_API_KEY=
# Follow-up passes (`paperwatch ingest --live --followup`): the window's pass cap, the wait between
# later passes and the hour it closes, in Europe/Rome. Unset means the defaults in config.py.
PW_FOLLOWUP_MAX_PASSES=
PW_FOLLOWUP_INTERVAL_S=
PW_FOLLOWUP_DEADLINE_HOUR=
# M2 chat: OpenRouter is required for any chat call; Groq is used only when both its key and its
# model id are set. Never commit real keys.
PW_OPENROUTER_API_KEY=
PW_CHAT_MODEL=
# The draft chain's own model. A draft asks the provider to refuse training on its inputs, and the
# shared chat model may have no endpoint that honours that. Unset means PW_CHAT_MODEL.
PW_DRAFT_MODEL=
PW_GROQ_API_KEY=
PW_GROQ_CHAT_MODEL=
PW_CHAT_TIMEOUT_S=
PW_CHAT_MAX_OUTPUT_TOKENS=
PW_CHAT_MAX_TOKENS_PER_ANSWER=
PW_CHAT_MAX_CALLS_PER_DAY=
PW_LOG_LEVEL=
# M3 API credential (`paperwatch serve --live`): "oidc" for a Vercel OIDC token, or "hmac" for the
# fallback token `paperwatch api-token --live` prints. One at a time: set the three OIDC values, or
# the 32+ character secret, never both. PW_API_PUBLIC_HOST is the tunnel's host name.
PW_API_AUTH=
PW_VERCEL_OIDC_ISSUER=
PW_VERCEL_OIDC_AUDIENCE=
PW_VERCEL_OIDC_SUBJECT=
PW_API_HMAC_SECRET=
PW_API_PUBLIC_HOST=
# arXiv asks bulk harvesters for a contact; in production set this with an address arXiv can reach.
PW_USER_AGENT=
